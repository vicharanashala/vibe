# Local development against the local backend + Firebase Auth emulator
# (see tools/local-api/README.md). The Vite dev server proxies /api and the
# emulator, so everything works through one port / SSH tunnel.
VITE_API_BASE_URL=
VITE_FIREBASE_PROJECT_ID=demo-vibe
VITE_FIREBASE_AUTH_EMULATOR_URL=same-origin

# Staging / production: set the real Firebase web config and backend origin,
# and remove VITE_FIREBASE_AUTH_EMULATOR_URL.
# VITE_API_BASE_URL=https://<backend-host>
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# Optional: the same reCAPTCHA v2 site key as the current app. Turn it on here
# only when the backend's IS_RECAPTCHA_ENABLED is "true".
# VITE_RECAPTCHA_SITE_KEY=
# VITE_IS_RECAPTCHA_ENABLED=true
