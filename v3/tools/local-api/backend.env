# Local ViBe backend for v3 development. No secrets in this file:
# DB_URL/DB_NAME and the throwaway Firebase key are read from ~/.config/vibe-v3/.
NODE_ENV=development
APP_PORT=4001
APP_URL=http://localhost:4001
APP_ORIGINS=http://localhost:4300
FRONTEND_URL=http://localhost:4300
APP_ROUTE_PREFIX=/api
APP_MODULE=all

# Firebase Auth emulator (no real Firebase project involved)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GCLOUD_PROJECT=demo-vibe
FIREBASE_PROJECT_ID=demo-vibe

IS_RECAPTCHA_ENABLED=false

# Keep background jobs off locally
ENABLE_DB_BACKUP=false
ENABLE_HP_JOB=false
ENABLE_FOLLOWUP_INVITE_JOB=false
ENABLE_FULFILLMENT_JOB=false
ENABLE_WATCHTIME_RECOVERY_JOB=false
ENABLE_ENROLLMENT_STATS_JOB=false
