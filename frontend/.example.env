# ─────────────────────────────────────────────────────────────────────
# Frontend env — production defaults
#
# These values point the JS SDK at the real Firebase project
# (`vibe-shash`). The backend (see `backend/.example.env`) must be
# configured against the SAME project id (`FIREBASE_PROJECT_ID`) for
# tokens to verify.
# ─────────────────────────────────────────────────────────────────────
VITE_BASE_URL=http://localhost:3141/api

VITE_FIREBASE_API_KEY=<your api key>
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<numeric sender id>
VITE_FIREBASE_APP_ID=<numeric app id>
# VITE_FIREBASE_MEASUREMENT_ID=<ga measurement id>   # optional

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL emulator wiring — DEV / DEMO ONLY.
#
# Uncomment + set `VITE_USE_FIREBASE_EMULATOR=true` to route
# authentication through the local Firebase Auth emulator instead of
# the real Firebase project. The backend MUST also be configured to
# point at the emulator (see `backend/.example.env`). Both ends must
# agree on the project id (`demo-test` is what the Milestone E seed
# script uses).
#
# Leave these commented for production deploys — the firebase.ts
# code path no-ops entirely when `VITE_USE_FIREBASE_EMULATOR` is not
# the literal string `"true"`.
# ─────────────────────────────────────────────────────────────────────
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL local-dev auth bypass. NOT for production. When true, the
# auth page exposes a "Skip login" path useful only for offline UI work.
# ─────────────────────────────────────────────────────────────────────
# VITE_DEV_AUTH_BYPASS=true
